rules_version = '2';

// Each signed-in Google account can only read or write documents under
// their own users/{uid}/data/* path. No one can see another user's data,
// and no unauthenticated request can read or write anything.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/data/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
